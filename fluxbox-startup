#!/bin/bash
# Fluxbox autostart script

# 1. Disable all workspaces except one to prevent windows "hiding" in other workspaces
fluxbox-remote "numworkspaces 1"

# 2. Set background color to match Forge dark mode
xsetroot -solid "#2b2b2b"

# 3. Wait for the Forge window to appear, then strip borders and maximize
(
  while true; do
    # Check if a window with "Forge" in the title exists
    if xwininfo -tree -root | grep -i "Forge" > /dev/null; then
        # Remove title bars/borders and force fullscreen/maximization
        wmctrl -r "Forge" -b add,maximized_vert,maximized_horz
        wmctrl -r "Forge" -b add,fullscreen
        break
    fi
    sleep 2
  done
) &

exec fluxbox
